#!/usr/bin/env bash

source "$HOME/framework.sh"
AGENTFILES="$WORKSPACE/repos/agentfiles"

agentsmd-symlink() {
    local source="$AGENTFILES/agentsmd/$1"
    local target="$2"
    symlink "$source/AGENTS.md" "$target/AGENTS.md"
    symlink "$source/AGENTS.md" "$target/CLAUDE.md"
}

# setup scripts
symlink "$AGENTFILES/scripts/add-skill.sh" "$HOME/bin/add-skill"
symlink "$AGENTFILES/scripts/add-command.sh" "$HOME/bin/add-command"
symlink "$AGENTFILES/scripts/add-all-skills.sh" "$HOME/bin/add-all-skills"
symlink "$AGENTFILES/scripts/add-all-commands.sh" "$HOME/bin/add-all-commands"

# configs
symlink "$AGENTFILES/codex/config.toml" "$HOME/.codex/config.toml"

# global
agentsmd-symlink "global" "$HOME/.codex"
agentsmd-symlink "global" "$HOME/.claude"
agentsmd-symlink "vault" "$WORKSPACE/vault"

# repos — auto-symlink any repo that has a matching agentsmd config
for repo in "$WORKSPACE"/repos/*/; do
    name="$(basename "$repo")"
    if [ -d "$AGENTFILES/agentsmd/$name" ]; then
        agentsmd-symlink "$name" "$repo"
    fi
done

# launchd agents — copied (not symlinked; launchd is unreliable with symlinked
# plists), then (re)loaded so plist changes take effect on re-run
mkdir -p "$HOME/Library/LaunchAgents"
for plist in "$AGENTFILES"/launchd/*.plist; do
    [ -f "$plist" ] || continue
    name="$(basename "$plist")"
    label="${name%.plist}"
    target="$HOME/Library/LaunchAgents/$name"
    cp "$plist" "$target"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$target"
    info "Loaded launchd agent $label"
done

# global skills & commands
add-all-skills
add-all-commands