{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(git worktree:*)",
      "Web Search(*)",
      "Fetch(*)"
    ],
    "additionalDirectories": [
      "~/workspace/vault",
      "~/workspace/repos-workspaces"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pstack@cursor-plugins": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowUnixSockets": [
        "~/.gnupg/S.gpg-agent",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/workspace/vault",
        "~/workspace/repos-workspaces"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "fastMode": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
